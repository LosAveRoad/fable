# 复制为 production.env 后填写真实值；该文件不会提交 Git

# VPS 1: MySQL
FABLE_MYSQL_HOST=116.62.153.14
FABLE_MYSQL_PORT=3306
FABLE_MYSQL_USER=fable
FABLE_MYSQL_PASSWORD=填写VPS1上的MySQL密码
FABLE_MYSQL_DATABASE=mychat

# VPS 1: Redis
FABLE_REDIS_HOST=116.62.153.14
FABLE_REDIS_PORT=6379
FABLE_REDIS_PASSWORD=填写VPS1上的Redis密码
FABLE_REDIS_DB=0
FABLE_REDIS_ENABLED=true
FABLE_REDIS_REQUIRED=true

# VPS 2: Kafka（暂按与 Fable 同机部署）
FABLE_KAFKA_ENABLED=true
FABLE_KAFKA_REQUIRED=true
FABLE_KAFKA_MODE=kafka
FABLE_KAFKA_BROKERS=38.147.170.246:9092
FABLE_KAFKA_TOPIC=fable.chat.message
FABLE_KAFKA_CONSUMER_GROUP=fable-chat
FABLE_KAFKA_PARTITION_COUNT=6

# 应用安全密钥
FABLE_JWT_SECRET=填写至少32位随机字符串
