# Local Fable application configuration
FABLE_MYSQL_USER=fable
FABLE_MYSQL_PASSWORD=fable-local-password
FABLE_JWT_SECRET=replace-with-at-least-32-random-characters

# The Compose Redis password and the password used by Fable must match.
REDIS_PASSWORD=fable-local-redis-password
FABLE_REDIS_PASSWORD=fable-local-redis-password
FABLE_REDIS_DB=0

FABLE_KAFKA_TOPIC=fable.chat.message
